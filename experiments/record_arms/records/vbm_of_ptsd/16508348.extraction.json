 "description": {
  "extraction_status": "extracted",
  "value": "The study compared morphometric measures, including hippocampal gray matter volume, between patients with posttraumatic stress disorder and healthy controls using region-of-interest analysis and voxel-based morphometry, and examined associations with disease duration, depression scores, and cognitive test scores.",
  "value_source": "generated",
  "evidence": {
   "status": "present",
   "sets": [
    {
     "source": "model_quote",
     "spans": [
      {
       "text": "The aims of this study were to: (1) confirm previous hippocampus findings in PTSD patients compared to controls, using ethnically similar study groups where alcohol and drug abuse were non-existent; (2) test influence of disease duration as well as depression scores on possible morphological changes; (3) test whether the voxel-based morphometry (VBM) data confirm the group differences seen in the region of interest (ROI) analysis, and (4) test the associations between the cognitive test scores and the morphological changes.",
       "start_char": 1706,
       "end_char": 2235
      }
     ]
    }
   ]
  }
