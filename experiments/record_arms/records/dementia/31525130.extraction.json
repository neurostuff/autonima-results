   "clinical_characteristics": {
    "extraction_status": "extracted",
    "value": "Progressive gait ataxia, slurred speech, oculomotor apraxia, restricted downward gaze, appendicular hypotonia, exaggerated deep tendon reflexes, and borderline intellectual function.",
    "value_source": "generated",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "source": "model_quote",
       "spans": [
        {
         "text": "Her speech was slurred. She had latency in initiating horizontal and vertical saccades (oculomotor apraxia) and the movements were slow (see supplementary video). Head thrust and eye blinks were used to initiate the saccades. Her vertical eye movements, especially down-gaze, were restricted with preserved vestibular-ocular reflex. Her horizontal and vertical pursuits were saccadic. She had appendicular hypotonia with preserved muscle bulk and normal power. She had incoordination of the upper and lower limbs along with severe gait ataxia requiring one-person support. Her deep tendon reflexes were exaggerated with extensor plantar reflex bilaterally.",
         "start_char": 3838,
         "end_char": 4494
        }
       ]
      }
     ]
    }
