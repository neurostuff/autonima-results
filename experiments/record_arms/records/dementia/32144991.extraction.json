 "analyses": [
  {
   "local_id": "ana_pet_remodulation",
   "name": {
    "extraction_status": "extracted",
    "value": "18F-FDG PET metabolic remodulation after suspension of Biperiden",
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "source": "model_quote",
       "spans": [
        {
         "text": "Seven months after the suspension of Biperiden, a 18F-FDG PET scan was repeated (September 2019), showing an extensive remodulation of metabolic activity (Fig. 3B).",
         "start_char": 10193,
         "end_char": 10357
        }
       ]
      }
     ]
    }
   },
   "definition": {
    "extraction_status": "extracted",
    "value": "The comparison of cortical metabolic activity before and after suspension of Biperiden, including the loss of the relative higher concentration of tracer in the prefrontal and inferior temporal cortex and of diffuse reduced metabolic activity.",
    "value_source": "generated",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "source": "model_quote",
       "spans": [
        {
         "text": "In particular, the relative higher concentration of the tracer in the prefrontal and inferior temporal cortex was no more visible. Similarly, the diffuse reduced metabolic activity could not be traced anymore.",
         "start_char": 19786,
         "end_char": 19995
        }
       ]
      }
     ]
    }
   },
   "prespecification": {
    "extraction_status": "extracted",
    "value": [
     "exploratory"
    ],
    "value_source": "generated",
    "evidence": {
     "status": "not_found"
    }
   },
   "interpretations": {
    "extraction_status": "extracted",
    "value": [
     "We can hypothesize that the initial cerebral metabolic aspect could be interpreted as the consequence of the anticholinergic activity of Biperiden.",
     "a more physiological cholinergic activity of the cortex may have been restored after the suspension of Biperiden"
    ],
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "source": "model_quote",
       "spans": [
        {
         "text": "We can hypothesize that the initial cerebral metabolic aspect could be interpreted as the consequence of the anticholinergic activity of Biperiden. Since no pathological events have occurred (TIA, delirium, etc.) in the meantime, a more physiological cholinergic activity of the cortex may have been restored after the suspension of Biperiden.",
         "start_char": 25453,
         "end_char": 25796
        }
       ]
      }
     ]
    }
   },
