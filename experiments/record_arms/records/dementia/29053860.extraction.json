   "interpretations": {
    "extraction_status": "extracted",
    "value": [
     "Nearly all pathological subgroups and even individual patients share atrophy in the anterior cingulate, frontoinsula, striatum, and amygdala, indicating that degeneration of these regions is intimately linked to the behavioural syndrome produced by these diverse aetiologies.",
     "Among high-confidence bvFTD patients, all 42 with MRI had left ventral frontoinsula atrophy, and 39 had bilateral frontoinsula, left anterior cingulate, left ventromedial frontal, bilateral striatal, and left amygdala atrophy.",
     "The overlapping atrophy pattern was present across FTLD subtypes and in patients with underlying Alzheimer’s disease, while differences in the severity and distribution of atrophy helped distinguish pathological subtypes."
    ],
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "source": "model_quote",
       "spans": [
        {
         "text": "Voxel-based morphometry revealed that nearly all pathological subgroups and even individual patients share atrophy in anterior cingulate, frontoinsula, striatum, and amygdala, indicating that degeneration of these regions is intimately linked to the behavioural syndrome produced by these diverse aetiologies.",
         "start_char": 1997,
         "end_char": 2306
        }
       ]
      }
     ]
    }
   }
