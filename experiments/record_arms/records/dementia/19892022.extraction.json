   "interpretations": {
    "extraction_status": "extracted",
    "value": [
     "For the AD versus control contrast, SPM and SPMpre confirmed the hippocampal involvement known from the ground-truth manual morphometry results, whereas DARTEL failed to identify this lesion when using only the original scans.",
     "The hippocampal lesion was picked up by DARTELpre using the preprocessed scans.",
     "Significant involvement of the occipital lobe was observed for all methods, but this appeared artifactual.",
     "DARTELpre produced the cleanest VBM results and detected with great precision the bilateral hippocampal atrophy known from the manual volume data."
    ],
    "value_source": "reported",
    "evidence": {
     "status": "present",
     "sets": [
      {
       "source": "model_quote",
       "spans": [
        {
         "text": "For the AD versus control contrast, there was, however, significant involvement of the occipital lobe for all methods that appeared artifactual. SPM and SPMPre confirmed the hippocampal involvement known from the ground-truth manual morphometry results, however, DARTEL failed to identify this lesion when using only the original scans. It was nonetheless picked up by DARTELpre, using the preprocessed scans",
         "start_char": 25319,
         "end_char": 25727
        }
       ]
      }
     ]
    }
   },
