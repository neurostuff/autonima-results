{
 "description": {
  "extraction_status": "extracted",
  "value": "The study investigated facial emotion recognition profiles and their neuroanatomical correlates in healthy older adults and older adults with mild cognitive impairment, Alzheimer’s disease, or frontotemporal dementia.",
  "value_source": "generated",
  "evidence": {
   "status": "present",
   "sets": [
    {
     "source": "model_quote",
     "spans": [
      {
       "text": "The current study showed profiles of FER in older adults (i.e., HC, MCI, AD, and FTD) and find neural correlates of FER",
       "start_char": 39025,
       "end_char": 39144
      }
     ]
    }
   ]
  }
 },
 "hypothesis": {
  "extraction_status": "extracted",
  "value": [
   "we hypothesized that patients with FTD would have lower FER performance than HCs or patients with MCI.",
   "we hypothesized that the difference between patients with FTD and those with AD would be equivocal",
   "we hypothesized that negative emotional content would have a larger effect size when distinguishing among groups than positive emotional content"
  ],
  "value_source": "reported",
  "evidence": {
   "status": "present",
   "sets": [
    {
     "source": "model_quote",
     "spans": [
      {
       "text": "Based on previous studies examining FER in HCs and patients with FTD, AD, and MCI, we hypothesized that patients with FTD would have lower FER performance than HCs or patients with MCI. Patients with AD are also expected to have deficits in FER (Hsieh et al., 2013). However, we hypothesized that the difference between patients with FTD and those with AD would be equivocal, as there are inconsistent results in this regard for the different emotions. Furthermore, we hypothesized that negative emotional content would have a larger effect size when distinguishing among groups than positive emotional content (Bora et al., 2016).",
       "start_char": 13880,
       "end_char": 14511
      }
     ]
    }
   ]
  }
 },
