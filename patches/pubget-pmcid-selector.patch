+    """Extract the PubMedCentral ID from an XML article.
+
+    PATCHED (autonima-results, 2026-09-04). PMC no longer emits
+    pub-id-type='pmc' on newer records; it emits 'pmcaid' (bare integer) and
+    'pmcid' (prefixed, e.g. 'PMC12571962'). The original single-selector
+    lookup returned None and every caller crashed on .text, which aborted
+    extraction for a WHOLE articleset batch -- so one modern article silently
+    discarded hundreds of successfully downloaded ones. Try each id type.
+    """
+    meta = "front/article-meta/article-id"
+    for id_type in ("pmc", "pmcaid", "pmcid"):
+        element = article.find(f"{meta}[@pub-id-type='{id_type}']")
+        if element is not None and element.text:
+            text = element.text.strip()
+            if text.upper().startswith("PMC"):
+                text = text[3:]
+            if text.isdigit():
+                return int(text)
+    raise ValueError("article carries no usable PMC identifier")
 
 
 def get_pmcid_from_article_dir(article_dir: Path) -> int:
