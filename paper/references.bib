@UNPUBLISHED{Peraza2025-mi,
  title    = "{NiCLIP}: Neuroimaging contrastive language-image pretraining
              model for predicting text from brain activation images",
  author   = "Peraza, Julio A and Kent, James D and Nichols, Thomas E and
